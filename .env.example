# Copy to .env and fill in your values — never commit .env

# Deployer wallet
DEPLOYER_ADDRESS=0xYourWalletAddress
PRIVATE_KEY=your_private_key_without_0x

# Arbitrum Sepolia RPC (public endpoint, no key needed)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Mainnet RPC for fork tests (Alchemy/Infura free tier)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Chainlink feeds on Arbitrum Sepolia
PRICE_FEED_ADDRESS=0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165
POR_FEED_ADDRESS=0x56a43EB56Da12C0dc1D972ACb089c06a5dEF8e69

# USDC on Arbitrum Sepolia (Circle official)
BORROW_TOKEN_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d

# Token metadata
RWA_NAME=US Treasury Bond Token
RWA_SYMBOL=USTB

# Arbiscan API key for --verify (free at arbiscan.io)
ARBISCAN_API_KEY=your_arbiscan_api_key
